<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from the build settings. -->

	<!-- Updates (Sparkle): the appcast attached to the latest GitHub release. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Pallepadehat/SeasonMyMac/releases/latest/download/appcast.xml</string>
	<!-- The public half of the key releases are signed with. The private half is in the maintainer's keychain. -->
	<key>SUPublicEDKey</key>
	<string>INrPWFJb/99Z6AYFLtsrN9yHTlRbtugGzgDDC1XJPeg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>

	<!-- Shown when the lights first listen to Apple Music or Spotify to follow the beat. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>SeasonMyMac listens to Apple Music or Spotify so your holiday lights can flash to the beat. Nothing is recorded or stored.</string>
</dict>
</plist>
